# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-publica"

